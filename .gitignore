# Binarios locales pesados que exceden el límite de 100 MB de GitHub (GH001)
herramientas/ffmpeg/*.exe
herramientas/ffmpeg/
*.exe

# Metadatos internos de agentes de IA, planes y bitácoras de trabajo
.agents/

# Archivos del sistema operativo y editores
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.tmp
*.log
*.pyc
__pycache__/
.vscode/
.idea/
